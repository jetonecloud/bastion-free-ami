!packer/example.pkrvars.hcl
!packer/x86_64.pkrvars.hcl
!packer/arm64.pkrvars.hcl
!packer/al2023-base.pkrvars.hcl
packer_cache/
*.pkr.hcl.bak
manifest.json
crash.log

# Build artifacts / reports
artifacts/
reports/
*.log

# Ansible
*.retry
.ansible/
# Pinned clone of hardened-al2023, fetched by scripts/fetch-upstream-roles.sh
# for al2023-base build mode. Never vendored into this repo.
ansible/.upstream/

# Terraform / OpenTofu
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
terraform.tfvars
!terraform.tfvars.example

# Python (ansible-lint / pre-commit venvs)
.venv/
__pycache__/
*.pyc

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets - never commit these
*.pem
*.ppk
.env
.env.*

CLAUDE.md
.claude/
