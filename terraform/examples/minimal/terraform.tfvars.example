# Copy to terraform.tfvars and edit.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init && terraform plan

region        = "us-east-1"
name          = "bfa-minimal"
vpc_cidr      = "10.20.0.0/16"
instance_type = "t3.small"

# Who may assume the access role. Use specific role ARNs in anything
# that is not a sandbox -- an account root ARN here means every
# principal in the account that can call sts:AssumeRole.
trusted_principal_arns = [
  "arn:aws:iam::111122223333:role/YourSsoOrEngineerRole",
]
